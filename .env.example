BE_APP_ENV=development
BE_LOG_LEVEL=DEBUG

# Supabase (hosted — not in docker-compose)
BE_SUPABASE_URL=https://your-project.supabase.co
BE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MongoDB
BE_MONGO_URI=mongodb://localhost:27017
BE_MONGO_DB_NAME=pattern_proof

# Neo4j
BE_NEO4J_URI=bolt://localhost:7687
BE_NEO4J_USER=neo4j
BE_NEO4J_PASSWORD=password

# Redis
BE_REDIS_URL=redis://localhost:6379

# Event bus
BE_EVENT_BUS=eager
BE_REDPANDA_BOOTSTRAP_SERVERS=localhost:9092

# JWT
BE_JWT_SECRET_KEY=change-me-in-production
BE_JWT_ALGORITHM=HS256
BE_ACCESS_TOKEN_TTL_MINUTES=60
BE_REFRESH_TOKEN_TTL_DAYS=30

# LLM
BE_ANTHROPIC_API_KEY=sk-ant-...
BE_OLLAMA_BASE_URL=https://your-ollama-cloud-url
BE_OLLAMA_API_KEY=
BE_GEMMA_MODEL=gemma2:27b
BE_CLAUDE_MODEL=claude-sonnet-4-6
